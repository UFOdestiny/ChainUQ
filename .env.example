# Copy to .env and adjust. Variables already set in the environment take precedence over this file.
# Relative paths are resolved against the repository root.
# Keep machine-specific paths and credentials in .env, which is excluded from Git.
# Share this example with portable defaults in anonymous source releases.

# Where every stage reads and writes (generations, judge labels, features, checkpoints, predictions, results).
CHAINUQ_ARTIFACTS=artifacts
# Prepared benchmark splits (python -m chainuq.pipeline.prepare_data).
CHAINUQ_DATASETS=datasets
# One directory per model, named as in chainuq/registry.py (e.g. models/Llama-3.1-8B-Instruct).
CHAINUQ_MODELS=models
# LaTeX project that receives the generated tables and figures (python -m chainuq.experiments.paper).
CHAINUQ_PAPER_DIR=latex
# Artifact tree of the 6,000-question adaptation pools (scripts/run_adaptation.sh).
CHAINUQ_POOL6K_ARTIFACTS=artifacts/pool_n6000
# Run logs of the driver scripts.
CHAINUQ_LOGS=${CHAINUQ_ARTIFACTS}/logs

# Interpreter and vLLM executable used by scripts/*.sh.
CHAINUQ_PYTHON=python
CHAINUQ_VLLM=vllm
# GPU for generation, feature extraction, and head training; GPU and port of the judge server.
CHAINUQ_GEN_GPU=0
CHAINUQ_JUDGE_GPU=1
CHAINUQ_JUDGE_PORT=8100

# Offline use of local models and the Hugging Face cache.
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
VLLM_NO_USAGE_STATS=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
