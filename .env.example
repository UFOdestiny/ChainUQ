# Copy to .env. Variables already set in the shell take precedence.
# Relative paths resolve against the repository root; ${NAME} expands earlier values.

# Storage
CHAINUQ_ARTIFACTS=artifacts
CHAINUQ_POOL_ARTIFACTS=${CHAINUQ_ARTIFACTS}/pools
CHAINUQ_ANALYSIS=${CHAINUQ_ARTIFACTS}/analysis
CHAINUQ_LOGS=${CHAINUQ_ARTIFACTS}/logs
CHAINUQ_DATASETS=datasets
CHAINUQ_MODELS=models
CHAINUQ_PAPER_DIR=latex

# Execution
CHAINUQ_PYTHON=python
CHAINUQ_VLLM=vllm
CHAINUQ_GEN_GPU=0
CHAINUQ_JUDGE_GPU=1
CHAINUQ_JUDGE_PORT=8100
CHAINUQ_WORKERS=30

# Libraries. Set HF_HUB_OFFLINE=1 after models and datasets are cached.
HF_HUB_OFFLINE=0
TOKENIZERS_PARALLELISM=false
VLLM_NO_USAGE_STATS=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# HF_HOME=/path/to/huggingface/cache
